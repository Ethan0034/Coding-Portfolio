from math import gcd

#set the ciphertext
ciphertext=''
ciphertext=''.join(c for c in ciphertext if c.isalpha())

#find trigrams in cipher text
trigram_freq ={}
for i in range(len(ciphertext)-2):
    temp_str=ciphertext[i:i+3]
    if temp_str in trigram_freq:
        trigram_freq[temp_str].append(i)
    else:
        trigram_freq[temp_str] = [i]

trigram_freq = {k:v for k,v in trigram_freq.items() if len(v) > 1}

#find the possible distances between each trigram patterns to find keylength
possible_lengths={}
for k,v in trigram_freq.items():
    if len(v) == 2:
        length = v[1]-v[0]
        if length in possible_lengths:
            possible_lengths[length] += 1
        else:
            possible_lengths[length]=1
    else:
        distances=[]
        for i in range(len(v)-1):
            distances.append(v[i+1]-v[i])
        for i in range(len(distances)-1):
            find_gcd=gcd(distances[i], distances[i+1])
            if find_gcd in possible_lengths:
                possible_lengths[find_gcd]+= 1
            else:
                possible_lengths[find_gcd] = 1
print(possible_lengths)


