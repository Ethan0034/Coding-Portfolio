#Step 2.1: Initial Permutation
def initialpermutation(x):
    
    #This function creates a new list 
    new_list=[]
    
    #Reorder the str based on IP Map table
    for i in IP_map:
        new_list.append(x[i])
    plaintext=''.join(new_list)
    return(plaintext)
