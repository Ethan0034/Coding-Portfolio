#Step 1: Get plaintext and convert it to binary.

def stringtobinary(p):
    #This takes the string and turns it into a binary string
    x=p.encode('utf-8')
    
    #This outputs the code as 0s and 1s
    x = ''.join(format(ord(i), '08b') for i in p)
    
    #This pads the string to be 64 bits long
    x=x.zfill(64)
    return(x)
    #print(type(x))

