#Step 2.2 Key Schedule Generation

def key_schedule():
    master_key = "0100100001001111010101110100010001011001010001000100111101001111"
    # Permuting the master key according to PC1
    master_key = [master_key[i] for i in PC1]
    round_keys = []
    C0 = master_key[0:28] # Get the left half of the permuted master key
    D0 = master_key[28:] # Get the left half of the permuted master key
    for i in range(16):
        C0 = C0[shifts[i]:] + C0[:shifts[i]] # Shift tthe halves according to what round we are currently on
        D0 = D0[shifts[i]:] + D0[:shifts[i]]
        # Join the two halves back together
        CD = C0+D0
        # Use PC2 to find the round key at append it to our list
        round_keys.append(''.join([CD[i] for i in PC2]))
    return round_keys

#Step 2.3 expand R
def expand_R(R_i):
    # Lists the mapping to get from 32 "bits" to 48 "bits"
    mapping = [31, 0, 1, 2, 3, 4, 3, 4, 5, 6, 7, 8, 7, 8, 9, 10, 11, 12, 11, 12,
               13, 14, 15, 16,
               15, 16, 17, 18, 19, 20, 19, 20, 21, 22, 23, 24, 23, 24, 25, 26, 27,
               28, 27, 28, 29, 30, 31, 0]
    # Create the expanded R_i using the above mapping
    expanded_R_i = ''.join([R_i[i] for i in mapping])
    return expanded_R_i

# This function takes in a STRING of 0s and 1s assuming it's a binary string,
# and returns its integer value
# I ASSUME BIG-ENDIAN FORMAT
def bin_to_int(bin_str):
    # Convert my strong of 0s and 1s into a list of 0s and 1s
    bin_list = [int(c) for c in bin_str]
    # Go through each item in my binary list and add onto vavlue when necessary
    value = 0
    for i in range(len(bin_list)):
        if bin_list[i]:
            value += 2**(len(bin_str)-i-1)
    return value

# This function takes in an integer and converts it to a binary string
def int_to_bin(x):
    bin_list = []
    mod_val = 2
    while x > 0:
        if x % mod_val:
            bin_list.append("1")
            x -= (x % mod_val)
        else:
            bin_list.append("0")
        mod_val *= 2
    return "".join(bin_list[::-1])


#Step 2.4 The Round Function(Repeat for 16 rounds)
def round_function(plaintext):
    
    #Get the round kyes
    round_key=key_schedule()
    
    #Split L and R into length 32 
    L=plaintext[:32]
    R=plaintext[32:]
    
    #Loop through the 16 rounds
    for key in (round_key):
    
        #Expand R ino 48 bit str to get newR
        Ri=expand_R(R)
        
        #XOR the key and the expanded R (newR) and turn it into a str
        R1=[]
        index=0
        for bit in key:
            if bit==Ri[index]:
                R1.append('0')
            else:
                R1.append('1')
            index+=1
        R1=''.join(R1)
        
        #Create 8 groups of 6 bits
        group=[]
        for i in range(0,len(R1),6):
            group.append(R1[i:i+6])
            
        
        tempR=[]
        
        #Loop through the different groups of 6 bits
        for x in group:
            
            #In each group use the outside bits to get the row and the inside bits to get the column
            row=x[0]+x[5]
            column=x[1:5]
            
            #change the values of these to integers
            row= bin_to_int(row)
            column=bin_to_int(column)
            #print(row,column)
            
            #loop through each 8 s-boxes
            for y in SBoxes:
                
                #if the index of group matches the index of the s-box
                if (group.index(x)==SBoxes.index(y)):
                    
                    #find the value represented by the row and column given by the x
                    value=y[row][column]
                    #print(value)
                    
                    #change the integer value given to binary and pad if needed
                    value=int_to_bin(value)
                    value=value.zfill(4)
                    tempR.append(value)
        
        # change tempR into a str instead of list
        tempR="".join(tempR)
        
        
        newR=[]
        count=0
        
        #XOR the R value and the prevous L value
        for bit in tempR:
            if bit==L[count]:
                newR.append('0')
            else:
                newR.append('1')
            count+=1
        
        #Turn newR into a str instead of list 
        newR=''.join(newR)
        
        #Set L to previous R and set R=to new R
        L=R
        R=newR
    return(L,R)

#Step 2.5 final permutation
def final_permutation(L,R):  
    
    #Swap L and R so R comes first
    string=R+L     

    #Swap the order of the str based on FP map
    final_list=[]
    for i in FP_map:
        final_list.append(string[i])
    ciphertext=''.join(final_list)
    return(ciphertext)

#Step 3 run all DES functions together to encrypt 
def des_encryption(plaintext):
    a=stringtobinary(plaintext)
    b=initialpermutation(a)
    c=round_function(b)
    d=final_permutation(c[0],c[1])
    print(d)
            
